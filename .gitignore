# Environnement Python
venv/
.venv/
__pycache__/
*.pyc
*.egg-info/

# Données (pas versionnées, seule la structure l'est via .gitkeep)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Base DuckDB
data/warehouse/*.duckdb
data/warehouse/*.duckdb.wal
!data/warehouse/.gitkeep

# Secrets
.env

# Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# Artefacts Windows/WSL
*:Zone.Identifier

# Package de déploiement Lambda (reconstruit à chaque déploiement, jamais versionné)
lambda-package/
lambda-*.zip
